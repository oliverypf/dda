# Normalize line endings on commit; check out platform-native.
# This repo is developed on Windows (core.autocrlf=true globally), so without
# this file the stored line endings would depend on each contributor's config.
* text=auto

# Windows-only shell/build scripts keep CRLF in the working tree.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Shell scripts must stay LF even on Windows.
*.sh   text eol=lf

# Binary assets: never touch line endings, never diff as text.
*.png  binary
*.jpg  binary
*.ico  binary
*.exe  binary
*.dll  binary
*.hap  binary
*.har  binary
