# ---- HarmonyOS / DevEco Studio ----
/oh_modules
**/oh_modules
**/build
/.hvigor
/.appanalyzer
/.bitfun
.cxx
/.clangd
/.clang-format
/.clang-tidy
**/.test
# DevEco writes machine-local SDK paths here; the file's own header says do not commit.
/local.properties

# ---- Node ----
node_modules/

# ---- linux-cli packaging output ----
/linux-cli/dist/

# ---- Rust / Cargo build output ----
# Real target dir plus the target-x64 / target-reliable / target-unlimited
# variants produced by the build scripts.
target/
target-x64/
target-reliable/
target-unlimited/

# ---- Tauri ----
# Sidecar binaries are produced by desktop/scripts/build-openviking-sidecar.mjs
# and bundled at build time; they are not sources.
/desktop/src-tauri/binaries/
# Generated ACL/capability schemas.
/desktop/src-tauri/gen/schemas/
/desktop/dist/

# ---- Path-accident guards ----
# Unexpanded environment variables and UNC roots have been written into the repo
# as literal directories before. These entries stop it recurring silently.
# See docs/WINDOWS_TESTING_WORKFLOW.md for the drive-mapping requirement.
/%SystemDrive%/
/%LOCALAPPDATA%/
/%APPDATA%/
/%USERPROFILE%/
/hwfs/
# Reserved Windows device names accidentally created as files by shell redirection.
/nul
/con
/prn
/aux

# ---- Transient artifacts ----
.tmp-release-check.json
*.tmp

# ---- Agent harness session state ----
/.pi/

# ---- Decision-Driven Agent runtime evidence ----
/.decision/
jev.config.json
# Raw per-run harness state (model requests, trajectory DBs, workspace copies).
# Curated evidence belongs in the dated docs/artifacts/<name>-<date> bundles instead.
/docs/artifacts/agent-goal-runs/

# ---- Harness² off-loop generated evidence ----
/offloop/out-*/
/offloop/out/
# Keep generated/runtime EXPERIENCE writes ignored while allowing the small
# curated in-repo contract and samples below.
/offloop/experience/**
!/offloop/experience/README.md
!/offloop/experience/schema.json
!/offloop/experience/index.json
!/offloop/experience/samples/
!/offloop/experience/samples/**
/offloop/bench/
# Self-hosted VPS migration bundles carry secrets/ and provider auth files; keep
# them out of the public repo and transfer them out of band.
/toeic-vps-migration-transfer-*.tar.gz
/toeic-vps-migration-*/

# ---- Local decision/debug scratch ----
/.codex-tmp/
**/__pycache__/
/desktop/phase2-*.log

# Phase-2b native addon intermediates (keep Release/*.node prebuild when present)
runtime/native/kernel-sandbox/build/Release/obj.target/
runtime/native/kernel-sandbox/build/Release/.deps/
runtime/native/kernel-sandbox/build/Makefile
runtime/native/kernel-sandbox/build/binding.Makefile
runtime/native/kernel-sandbox/build/config.gypi
runtime/native/kernel-sandbox/build/*.target.mk
