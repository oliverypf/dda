{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hmcodex.local/contracts/v1/memory-record.schema.json",
  "title": "dda Memory Record",
  "description": "A redacted, source-linked memory record. Proposed memories are not active until verified and activated.",
  "type": "object",
  "additionalProperties": false,
  "required": ["memoryId", "runId", "statement", "sourceEventIds", "scope", "confidence", "kind", "validFromMs", "createdAtMs", "updatedAtMs", "status", "history", "recordDigest"],
  "properties": {
    "memoryId": { "type": "string", "minLength": 1, "maxLength": 240 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 240 },
    "statement": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "sourceEventIds": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 240 } },
    "scope": { "type": "string", "minLength": 1, "maxLength": 256 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
    "key": { "type": "string", "minLength": 1, "maxLength": 256 },
    "validFromMs": { "type": "integer", "minimum": 0 },
    "expiresAtMs": { "type": "integer", "minimum": 0 },
    "createdAtMs": { "type": "integer", "minimum": 0 },
    "updatedAtMs": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["PROPOSED", "VERIFIED", "REJECTED", "ACTIVE", "RETRACTED", "EXPIRED", "PRUNED"] },
    "verification": { "type": "string", "maxLength": 500 },
    "verifiedAtMs": { "type": "integer", "minimum": 0 },
    "activatedAtMs": { "type": "integer", "minimum": 0 },
    "useCount": { "type": "integer", "minimum": 0 },
    "lastUsedAtMs": { "type": "integer", "minimum": 0 },
    "lastUsedRunDigest": { "$ref": "#/$defs/digest" },
    "untrainable": { "type": "boolean", "const": true },
    "untrainableAtMs": { "type": "integer", "minimum": 0 },
    "history": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/history" } },
    "recordDigest": { "$ref": "#/$defs/digest" },
    "lifecycleDigest": { "$ref": "#/$defs/digest" }
  },
  "allOf": [{
    "if": { "properties": { "status": { "const": "ACTIVE" } } },
    "then": { "properties": { "sourceEventIds": { "minItems": 1 } } }
  }],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "history": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "to", "atMs"],
      "properties": {
        "from": { "type": "string", "minLength": 1, "maxLength": 40 },
        "to": { "type": "string", "minLength": 1, "maxLength": 40 },
        "atMs": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string", "maxLength": 500 }
      }
    }
  }
}
