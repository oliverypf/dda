{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dda",
  "mainBinaryName": "dda-desktop",
  "version": "0.1.0",
  "identifier": "com.hmcodex.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "dda",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 540,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "dda",
    "targets": ["msi", "nsis"],
    "windows": {
      "wix": {
        "upgradeCode": "10fec2aa-b588-528e-9951-92bb36312b9d"
      },
      "nsis": {
        "installMode": "perMachine",
        "template": "installer-brand-compat.nsi"
      }
    },
    "resources": {
      "../../runtime/src": "runtime/src",
      "../../runtime/node_modules": "runtime/node_modules",
      "../../runtime/package.json": "runtime/package.json",
      "../../runtime/package-lock.json": "runtime/package-lock.json",
      "../../runtime/model-config.example.json": "runtime/model-config.example.json"
    },
    "icon": ["icons/app-icon.png", "icons/icon.ico"],
    "shortDescription": "Local read-only dda workbench",
    "longDescription": "A Windows-first local workbench for read-only project inspection and task timelines."
  }
}
