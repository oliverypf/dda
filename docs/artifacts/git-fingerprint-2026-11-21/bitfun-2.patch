+// Hook content is tracked by contentDigest. Newer Git also records an
+// mtime/ctime anti-tamper trailer inside each sample hook, so a fixture setup
+// or hook installer rewriting them must not change the fingerprint by
+// timestamps alone; the sampled hooksDirectoryMtimeMs below still catches a
+// hook being added or removed because a directory change always moves it.
+const hookDigest = (content) => {
+  const text = content.toString('utf8');
+  if (!text.startsWith('#!/')) return digestBytes(content);
+  const body = text.split(/\r?\n/u)
+    .filter((line) => !/^#.*[0-9a-f]{20,}[0-9a-f ]*[0-9a-f]{20,}.*$/iu.test(line))
+    .join('\n');
+  return digestBytes(Buffer.from(body, 'utf8'));
+};
+
+const readHooksDigest = async (hooksDirectory) => {
+  const sampleDigests = [];
+  const hookNames = await readdir(hooksDirectory).catch(() => []);
+  for (const name of hookNames.filter((entry) => typeof entry === 'string').sort()) {
+    const metadata = await lstat(resolve(hooksDirectory, name)).catch(() => null);
+    if (!metadata?.isFile() || !metadata.size || metadata.size > MAX_METADATA_FILE_BYTES) continue;
+    const content = await readFile(resolve(hooksDirectory, name)).catch(() => null);
+    if (content) sampleDigests.push({ name: digestText(name), digest: hookDigest(content) });
+  }
+  return sampleDigests;
+};
+
+const directoryMtimeMs = async (directory) => {
+  const metadata = await lstat(directory).catch(() => null);
+  if (!metadata) return 0;
+  // Coarse (whole second) so a re-created directory cannot flip the sample;
+  // changed entries are caught by existence/type, hidden content by hookDigest.
+  return Number.isFinite(metadata.mtimeMs) ? Math.trunc(metadata.mtimeMs / 1000) : 0;
+};
