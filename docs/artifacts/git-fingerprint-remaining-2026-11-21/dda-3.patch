diff --git a/probe-metadata.mjs b/probe-metadata.mjs
new file mode 100644
--- /dev/null
+++ b/probe-metadata.mjs
@@ -0,0 +1,48 @@
+import { mkdtemp, readFile, readdir, stat, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { createHash } from 'node:crypto';
+import { spawn } from 'node:child_process';
+
+const sha = (value) => `sha256:${createHash('sha256').update(value).digest('hex').slice(0, 16)}`;
+const runGit = (cwd, args) => new Promise((resolve, reject) => {
+  const child = spawn(process.platform === 'win32' ? 'git.exe' : 'git', args, {
+    cwd, env: { ...process.env, GIT_CONFIG_NOSYSTEM: '1', GIT_TERMINAL_PROMPT: '0' }, shell: false, windowsHide: true,
+    stdio: ['ignore', 'pipe', 'pipe']
+  });
+  let out = ''; let err = '';
+  child.stdout.on('data', (c) => { out += c; });
+  child.stderr.on('data', (c) => { err += c; });
+  child.once('error', reject);
+  child.once('close', (code) => (code === 0 ? resolve(out) : reject(new Error(err))));
+});
+
+const root = await mkdtemp(join(tmpdir(), 'probe-git-meta-'));
+await runGit(root, ['init', '-q']);
+await runGit(root, ['config', 'user.email', 'a@b.invalid']);
+await runGit(root, ['config', 'user.name', 'A']);
+await writeFile(join(root, 'README.md'), '# fixture\n', 'utf8');
+await runGit(root, ['add', 'README.md']);
+await runGit(root, ['commit', '-qm', 'fixture']);
+
+const dump = async (label) => {
+  const gitDir = join(root, '.git');
+  const names = (await readdir(gitDir)).sort();
+  const lines = [];
+  for (const name of names) {
+    const path = join(gitDir, name);
+    const info = await stat(path).catch(() => null);
+    if (!info || !info.isFile()) { lines.push(`${name} dir`); continue; }
+    const content = await readFile(path).catch(() => Buffer.alloc(0));
+    lines.push(`${name} size=${content.byteLength} sha=${sha(content)} mtime=${Math.trunc(info.mtimeMs)}`);
+  }
+  console.log(`--- ${label} ---`);
+  for (const line of lines) console.log(line);
+};
+
+await dump('before');
+await writeFile(join(root, 'README.md'), '# updated\n', 'utf8');
+await runGit(root, ['status']);
+await dump('after-status');
+await writeFile(join(root, '.git', 'FETCH_HEAD'), `${'0'.repeat(40)}\tnot-for-merge\tbranch main\n`, 'utf8');
+await dump('after-fetchhead-write');
