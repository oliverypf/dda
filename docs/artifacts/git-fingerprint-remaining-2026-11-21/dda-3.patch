diff --git a/probe-digest.mjs b/probe-digest.mjs
new file mode 100644
--- /dev/null
+++ b/probe-digest.mjs
@@ -0,0 +1,41 @@
+import { mkdtemp, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { spawn } from 'node:child_process';
+import { createGitObserver } from './runtime/src/git-observer.mjs';
+
+const runGit = (cwd, args) => new Promise((resolve, reject) => {
+  const child = spawn(process.platform === 'win32' ? 'git.exe' : 'git', args, {
+    cwd, env: { ...process.env, GIT_CONFIG_NOSYSTEM: '1', GIT_TERMINAL_PROMPT: '0' }, shell: false, windowsHide: true,
+    stdio: ['ignore', 'pipe', 'pipe']
+  });
+  let out = ''; let err = '';
+  child.stdout.on('data', (c) => { out += c; });
+  child.stderr.on('data', (c) => { err += c; });
+  child.once('error', reject);
+  child.once('close', (code) => (code === 0 ? resolve(out) : reject(new Error(err))));
+});
+
+const root = await mkdtemp(join(tmpdir(), 'probe-git-digest-'));
+await runGit(root, ['init', '-q']);
+await runGit(root, ['config', 'user.email', 'a@b.invalid']);
+await runGit(root, ['config', 'user.name', 'A']);
+await writeFile(join(root, 'README.md'), '# fixture\n', 'utf8');
+await runGit(root, ['add', 'README.md']);
+await runGit(root, ['commit', '-qm', 'fixture']);
+
+const observer = createGitObserver({ workspaceRoot: root });
+const before = await observer.snapshot({ reason: 'ACTION_STARTED' });
+await writeFile(join(root, 'README.md'), '# updated\n', 'utf8');
+await runGit(root, ['status']);
+await writeFile(join(root, '.git', 'FETCH_HEAD'), `${'0'.repeat(40)}\tnot-for-merge\tbranch main\n`, 'utf8');
+const after = await observer.snapshot({ reason: 'ACTION_COMPLETED' });
+console.log('metadataDigest equal:', before.metadataDigest === after.metadataDigest);
+console.log('before', before.metadataDigest);
+console.log('after ', after.metadataDigest);
+console.log('indexDigest equal:', before.indexDigest === after.indexDigest);
+console.log('index before', before.indexDigest);
+console.log('index after ', after.indexDigest);
+console.log('pathDigests equal:', JSON.stringify(before.status.pathDigests) === JSON.stringify(after.status.pathDigests));
+console.log('statusCodes before', JSON.stringify(before.status.statusCodes));
+console.log('statusCodes after ', JSON.stringify(after.status.statusCodes));
