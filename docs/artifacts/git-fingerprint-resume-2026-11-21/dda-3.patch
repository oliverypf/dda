diff --git a/runtime/test/tmp-hooks-probe.mjs b/runtime/test/tmp-hooks-probe.mjs
new file mode 100644
--- /dev/null
+++ b/runtime/test/tmp-hooks-probe.mjs
@@ -0,0 +1,59 @@
+import { mkdtemp, writeFile, readFile, readdir, lstat } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { spawn } from 'node:child_process';
+import { createHash } from 'node:crypto';
+
+const runGit = (cwd, args) => new Promise((resolve, reject) => {
+  const child = spawn(process.platform === 'win32' ? 'git.exe' : 'git', args, {
+    cwd,
+    env: { ...process.env, GIT_CONFIG_NOSYSTEM: '1', GIT_TERMINAL_PROMPT: '0' },
+    shell: false,
+    windowsHide: true,
+    stdio: ['ignore', 'pipe', 'pipe']
+  });
+  let stdout = '';
+  let stderr = '';
+  child.stdout.on('data', (chunk) => { stdout += chunk; });
+  child.stderr.on('data', (chunk) => { stderr += chunk; });
+  child.once('error', reject);
+  child.once('close', (code) => { if (code !== 0) reject(new Error(`git failed: ${args.join(' ')}: ${stderr}`)); else resolve(stdout); });
+});
+
+const hooksProbe = async (gitDir) => {
+  const dir = join(gitDir, 'hooks');
+  const names = (await readdir(dir).catch(() => [])).sort();
+  const out = {};
+  for (const name of names) {
+    const p = join(dir, name);
+    const st = await lstat(p).catch(() => null);
+    if (!st) { out[name] = 'ABSENT'; continue; }
+    const buf = await readFile(p).catch(() => null);
+    out[name] = `${st.isFile() ? 'file' : 'other'}|${st.size}|${buf ? createHash('sha256').update(buf).digest('hex').slice(0, 8) : 'noread'}`;
+  }
+  return out;
+};
+
+const root = await mkdtemp(join(tmpdir(), 'hmcodex-probe2-'));
+await runGit(root, ['init', '-q']);
+await runGit(root, ['config', 'user.email', 'a@b.invalid']);
+await runGit(root, ['config', 'user.name', 'Probe']);
+await writeFile(join(root, 'README.md'), '# a\n', 'utf8');
+await runGit(root, ['add', 'README.md']);
+await runGit(root, ['commit', '-qm', 'fixture']);
+const gitDir = join(root, '.git');
+const before = await hooksProbe(gitDir);
+await writeFile(join(root, 'README.md'), '# updated\n', 'utf8');
+await runGit(root, ['status']);
+const afterStatus = await hooksProbe(gitDir);
+await runGit(root, ['add', 'README.md']);
+const afterAdd = await hooksProbe(gitDir);
+const only = (a, b) => Object.fromEntries(Object.entries(b).filter(([k, v]) => a[k] !== v));
+console.log(JSON.stringify({
+  root,
+  beforeCount: Object.keys(before).length,
+  afterStatusCount: Object.keys(afterStatus).length,
+  addedOrChangedAfterStatus: only(before, afterStatus),
+  removedAfterStatus: Object.fromEntries(Object.entries(before).filter(([k]) => !(k in afterStatus))),
+  addedOrChangedAfterAdd: only(afterStatus, afterAdd)
+}, null, 2));
diff --git a/runtime/test/tmp-meta-entry-probe.mjs b/runtime/test/tmp-meta-entry-probe.mjs
