+++ b/runtime/test/tmp-observer-probe.mjs
@@ -0,0 +1,44 @@
+import { mkdtemp, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { spawn } from 'node:child_process';
+import { createGitObserver } from '../src/git-observer.mjs';
+
+const runGit = (cwd, args) => new Promise((resolve, reject) => {
+  const child = spawn(process.platform === 'win32' ? 'git.exe' : 'git', args, {
+    cwd,
+    env: { ...process.env, GIT_CONFIG_NOSYSTEM: '1', GIT_TERMINAL_PROMPT: '0' },
+    shell: false,
+    windowsHide: true,
+    stdio: ['ignore', 'pipe', 'pipe']
+  });
+  let stdout = '';
+  let stderr = '';
+  child.stdout.on('data', (chunk) => { stdout += chunk; });
+  child.stderr.on('data', (chunk) => { stderr += chunk; });
+  child.once('error', reject);
+  child.once('close', (code) => { if (code !== 0) reject(new Error(`git failed: ${args.join(' ')}: ${stderr}`)); else resolve(stdout); });
+});
+
+const root = await mkdtemp(join(tmpdir(), 'hmcodex-observer-probe-'));
+await runGit(root, ['init', '-q']);
+await runGit(root, ['config', 'user.email', 'a@b.invalid']);
+await runGit(root, ['config', 'user.name', 'Probe']);
+await writeFile(join(root, 'README.md'), '# a\n', 'utf8');
+await runGit(root, ['add', 'README.md']);
+await runGit(root, ['commit', '-qm', 'fixture']);
+const observer = createGitObserver({ workspaceRoot: root });
+const before = await observer.snapshot({ reason: 'ACTION_STARTED' });
+await writeFile(join(root, 'README.md'), '# updated\n', 'utf8');
+await runGit(root, ['status']);
+await writeFile(join(root, '.git', 'FETCH_HEAD'), '0'.repeat(40) + '\tnot-for-merge\tbranch main\n', 'utf8');
+const after = await observer.snapshot({ reason: 'ACTION_COMPLETED' });
+const fields = ['headDigest', 'indexDigest', 'workingTreeDigest', 'untrackedDigest', 'metadataDigest', 'metadataLinkDetected'];
+const deltas = {};
+for (const field of fields) if (before[field] !== after[field]) deltas[field] = { before: before[field], after: after[field] };
+console.log(JSON.stringify({
+  root,
+  changedFields: deltas,
+  beforeStatus: before.status,
+  afterStatus: after.status
+}, null, 2));
