+++ b/runtime/test/tmp-meta-entry-probe.mjs
@@ -0,0 +1,83 @@
+import { mkdtemp, writeFile, readFile, readdir, lstat, realpath } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { spawn } from 'node:child_process';
+import { createHash } from 'node:crypto';
+
+const runGit = (cwd, args) => new Promise((resolve, reject) => {
+  const child = spawn(process.platform === 'win32' ? 'git.exe' : 'git', args, {
+    cwd,
+    env: { ...process.env, GIT_CONFIG_NOSYSTEM: '1', GIT_TERMINAL_PROMPT: '0' },
+    shell: false,
+    windowsHide: true,
+    stdio: ['ignore', 'pipe', 'pipe']
+  });
+  let stdout = '';
+  let stderr = '';
+  child.stdout.on('data', (chunk) => { stdout += chunk; });
+  child.stderr.on('data', (chunk) => { stderr += chunk; });
+  child.once('error', reject);
+  child.once('close', (code) => { if (code !== 0) reject(new Error(`git failed: ${args.join(' ')}: ${stderr}`)); else resolve(stdout); });
+});
+
+// Mirror readGitMetadata entry-by-entry so the differing key can be identified.
+const METADATA_FILES = ['HEAD', 'config', 'index', 'packed-refs', 'MERGE_HEAD', 'CHERRY_PICK_HEAD', 'REVERT_HEAD', 'ORIG_HEAD', 'FETCH_HEAD', 'shallow'];
+const VOLATILE = new Set(['index', 'FETCH_HEAD']);
+const digest = (buf) => createHash('sha256').update(buf).digest('hex').slice(0, 12);
+
+const entry = async (p, volatileContent) => {
+  const st = await lstat(p).catch(() => null);
+  if (!st) return { exists: false };
+  const type = st.isSymbolicLink() ? 'link' : st.isFile() ? 'file' : st.isDirectory() ? 'directory' : 'other';
+  if (volatileContent) return type === 'link' ? { exists: true, type } : {};
+  const out = { exists: true, type, size: Number.isFinite(st.size) ? st.size : 0, mode: st.mode };
+  if (st.isFile() && st.size <= 16 * 1024 * 1024) {
+    const buf = await readFile(p).catch(() => null);
+    if (buf) out.contentDigest = digest(buf);
+    else out.mtimeMs = Math.trunc(st.mtimeMs);
+  } else {
+    out.mtimeMs = Math.trunc(st.mtimeMs);
+  }
+  return out;
+};
+
+const snapshotMetadata = async (root) => {
+  const gitDir = await realpath(join(root, '.git')).catch(() => join(root, '.git'));
+  const entries = {};
+  for (const name of METADATA_FILES) entries[name] = await entry(join(gitDir, name), VOLATILE.has(name));
+  const hookNames = (await readdir(join(gitDir, 'hooks')).catch(() => [])).filter((n) => typeof n === 'string').sort();
+  entries.hooks = {};
+  for (const name of hookNames) entries.hooks[digest(Buffer.from(name, 'utf8'))] = await entry(join(gitDir, 'hooks', name), false);
+  entries.hooksTruncated = false;
+  return entries;
+};
+
+const diff = (a, b) => {
+  const out = [];
+  for (const key of new Set([...Object.keys(a), ...Object.keys(b)])) {
+    const left = JSON.stringify(a[key]);
+    const right = JSON.stringify(b[key]);
+    if (left !== right) out.push({ key, before: left, after: right });
+  }
+  return out;
+};
+
+const root = await mkdtemp(join(tmpdir(), 'hmcodex-meta-probe-'));
+await runGit(root, ['init', '-q']);
+await runGit(root, ['config', 'user.email', 'a@b.invalid']);
+await runGit(root, ['config', 'user.name', 'Probe']);
+await writeFile(join(root, 'README.md'), '# a\n', 'utf8');
+await runGit(root, ['add', 'README.md']);
+await runGit(root, ['commit', '-qm', 'fixture']);
+const before = await snapshotMetadata(root);
+await writeFile(join(root, 'README.md'), '# updated\n', 'utf8');
+await runGit(root, ['status']);
+const afterStatus = await snapshotMetadata(root);
+await writeFile(join(root, '.git', 'FETCH_HEAD'), '0'.repeat(40) + '\tnot-for-merge\tbranch main\n', 'utf8');
+const afterFetch = await snapshotMetadata(root);
+console.log(JSON.stringify({
+  root,
+  afterStatusDiff: diff(before, afterStatus),
+  afterFetchDiff: diff(afterStatus, afterFetch),
+  beforeKeys: Object.keys(before)
+}, null, 2));
